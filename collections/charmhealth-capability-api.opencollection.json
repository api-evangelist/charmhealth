{
  "opencollection": "1.0.0",
  "info": {
    "name": "CharmHealth FHIR AllergyIntolerance Capability API",
    "version": "4.0.1"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://ehr2.charmtracker.com/oauth/v2/token",
      "credentials": {
        "clientId": "{{clientId}}",
        "clientSecret": "{{clientSecret}}"
      }
    }
  },
  "items": [
    {
      "info": {
        "name": "Capability",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get FHIR CapabilityStatement",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://ehr2.charmtracker.com/api/ehr/v2/fhir/metadata"
          },
          "docs": "Get FHIR CapabilityStatement"
        }
      ]
    }
  ],
  "bundled": true
}